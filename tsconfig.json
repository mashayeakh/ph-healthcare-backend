{
  "compilerOptions": {
    "module": "ESNext",
    "rootDir": ".",                    
    "outDir": "./dist",
    "moduleResolution": "bundler",
    "target": "ES2023",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",                     // Add this
    "paths": {                          // Add this for cleaner imports
      "@/*": ["src/*"],
      "@prisma/*": ["prisma/generated/*"]
    }
  },
  "include": [
    "src/**/*", 
    "prisma/generated/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}